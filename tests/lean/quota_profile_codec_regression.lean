example (l xs) (h : Fits l xs) : strictDecode l (encodeV1 xs) = some xs := decode_encodeV1 l xs h
example (l b xs) (h : strictDecode l b = some xs) : Fits l xs ∧ encodeV1 xs = b := decode_canonical
  l b xs h
example : Function.Injective encodeV1 := encodeV1_injective
example (l b) (h : l.maxSizeBytes = 0) : strictDecode l b = none := zero_size_refuses l h b
example (l n p b xs) : decodeExpected? l n p b = some xs ↔ Fits l xs ∧ encodeV1 xs = b ∧ Matches n
  p xs := decodeExpected_iff l n p b xs
example (l n p j ε b s out) : restoreProfileBytes? l n p j ε b s = some out ↔ Fits l (exportProfile
  n p) ∧ encodeV1 (exportProfile n p) = b ∧ ValidSnapshot n p j ε s ∧ out = s
  := restoreProfileBytes_iff l n p j ε b s out

